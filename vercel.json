{
  "ignoreCommand": "p=$VERCEL_GIT_PREVIOUS_SHA;[ -n \"$p\" ]||exit 1;git cat-file -e \"$p^{commit}\" 2>/dev/null||git fetch -q --deepen=300 2>/dev/null;git cat-file -e \"$p^{commit}\" 2>/dev/null&&git diff --quiet \"$p\" HEAD -- . \":!docs\"&&exit 0;exit 1",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "goasksam.vercel.app" }],
      "destination": "https://goasksam.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/sell",
      "permanent": true
    },
    {
      "source": "/rudy",
      "destination": "/api/crew?guest=clint&to=/sell",
      "permanent": false
    },
    {
      "source": "/onebox",
      "destination": "/market-check",
      "permanent": true
    },
    {
      "source": "/partner-demo",
      "destination": "/preview",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/task-link", "destination": "/api/watch" },
    { "source": "/sell", "has": [{ "type": "query", "key": "car" }], "destination": "/api/sellNext" },
