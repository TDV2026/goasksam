{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "goasksam.vercel.app" }],
      "destination": "https://goasksam.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/sell",
      "permanent": true
    },
    {
      "source": "/rudy",
      "destination": "/api/crew?guest=clint&to=/sell",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/sell", "destination": "/api/sellNext" },
    { "source": "/sell-next", "destination": "/api/sellNext" },
    { "source": "/tasks", "destination": "/api/tasksPage" },
    { "source": "/onebox", "destination": "/onebox.html" },
    { "source": "/o/:id", "destination": "/api/publicConfig?obShare=:id" },
    { "source": "/onebox-preview", "destination": "/onebox-preview.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/how-sam-decides", "destination": "/how-sam-decides.html" },
    { "source": "/business", "destination": "/business.html" },
    { "source": "/powersellers", "destination": "/powersellers.html" },
    { "source": "/mcp", "destination": "/mcp.html" },
    { "source": "/(google[A-Za-z0-9_-]+\\.html)", "destination": "/api/gsc?file=$1" },
    { "source": "/out", "destination": "/api/out" },
    { "source": "/styles.20260907a.css", "destination": "/styles.css" },
    { "source": "/js.20261009a/(.*)", "destination": "/js/$1" },
    { "source": "/obx.20261012a/(.*)", "destination": "/js/$1" },
    { "source": "/desk", "destination": "/desk.html" },
    { "source": "/history/:slug/:vin", "destination": "/api/history?slug=:slug&vin=:vin" },
    { "source": "/history/:slug", "destination": "/api/history?slug=:slug" },
    { "source": "/vin/:vin", "destination": "/api/history?vin=:vin&go=1" },
    { "source": "/sitemap-vins.xml", "destination": "/api/history?sitemap=index" },
    { "source": "/sitemap-vins-hubs.xml", "destination": "/api/history?sitemap=hubs" },
    { "source": "/sitemap-vins-(\\d+).xml", "destination": "/api/history?sitemap=$1" },
    { "source": "/sitemap-motorcycles.xml", "destination": "/api/history?sitemap=motorcycles" },
    { "source": "/sitemap-other.xml", "destination": "/api/history?sitemap=other" },
    { "source": "/buy", "destination": "/api/buy" },
    { "source": "/dsk.20260928k/(.*)", "destination": "/js/$1" },
    { "source": "/dsk.20261006a/(.*)", "destination": "/js/$1" },
    { "source": "/dsk.20261006b/(.*)", "destination": "/js/$1" },
    { "source": "/dsk.20261006c/(.*)", "destination": "/js/$1" },
    { "source": "/dsk.20261006d/(.*)", "destination": "/js/$1" }
  ],
  "functions": {
    "api/usageDashboard.js": {
      "maxDuration": 300,
      "includeFiles": "scripts/warm-list.json"
    },
    "api/publicConfig.js": {
      "includeFiles": "onebox.html"
    },
    "api/sellPage.js": {
      "includeFiles": "index.html"
    },
    "api/sellerDecision.js": {
      "maxDuration": 60
    },
    "api/desk.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/usageDashboard?view=ops&task=depth", "schedule": "0 8 * * *" },
    { "path": "/api/usageDashboard?view=ops&task=fill", "schedule": "0 12 * * *" },
    { "path": "/api/pullLive", "schedule": "15 */4 * * *" },
    { "path": "/api/refreshSpecLiveCounts", "schedule": "35 */4 * * *" },
    { "path": "/api/tasks?run=1", "schedule": "35 */4 * * *" },
    { "path": "/api/history?photocheck=vins", "schedule": "40 9 * * *" },
    { "path": "/api/history?photocheck=hubs", "schedule": "50 9 * * *" }
  ]
}
