{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "goasksam.vercel.app" }],
      "destination": "https://goasksam.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/out", "destination": "/api/out" },
    { "source": "/styles.20260809y.css", "destination": "/styles.css" }
  ],
  "functions": {
    "api/usageDashboard.js": {
      "maxDuration": 300,
      "includeFiles": "scripts/warm-list.json"
    }
  },
  "crons": [
    { "path": "/api/usageDashboard?view=ops&task=fill", "schedule": "0 9 * * *" }
  ]
}
