 {
  "name": "the car line comes from the newest appearance, not the sale",
  "edits": [
   {
    "file": "api/_historyData.js",
    "from": "g.car = ((g.lastSale && g.lastSale.car) || (g.apps.find(x => x.car) || {}).car) || null;",
    "to": "g.car = (g.apps.find(x => x.car) || {}).car || null;"
   }
  ]
 },
 {
  "name": "a car with no name is guessed",
  "edits": [
   {
    "file": "api/_historyData.js",
    "from": "return y || m || f || b ? { year: y, model: m, modelFamily: f, body: b } : null;",
    "to": "return { year: y, model: m || \"Car\", modelFamily: f, body: b };"
   }
  ]
 },
 {
  "name": "the car line leaves out the year",
  "edits": [
   {
    "file": "api/history.js",
    "from": "return [c.year, name, body].filter(Boolean).join(\" \");",
    "to": "return [name, body].filter(Boolean).join(\" \");"
   }
  ]
 },
 {
  "name": "the car line leaves out the body",
  "edits": [
   {
    "file": "api/history.js",
    "from": "return [c.year, name, body].filter(Boolean).join(\" \");",
    "to": "return [c.year, name].filter(Boolean).join(\" \");"
   }
  ]
 },
 {
  "name": "the body is said twice",
  "edits": [
   {
    "file": "api/history.js",
    "from": "c.body && !name.toLowerCase().includes(String(c.body).toLowerCase()) ? c.body : \"\"",
    "to": "c.body || \"\""
   }
  ]
 },
